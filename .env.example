# God's Eye View — environment variables (names and placeholders only).
# Copy to .env (git-ignored). Every key is optional: with none set the app
# starts on keyless Esri World Imagery, anonymous flight feeds, CelesTrak,
# USGS, NOAA and the bundled datasets.
#
# CLIENT-EXPOSED: GOOGLE_MAPS_API_KEY and CESIUM_ION_TOKEN are injected into
# the browser bundle by design. Restrict them (see SECURITY.md).
# Everything else stays on the server.

# Google Photorealistic 3D Tiles (direct) and place search. CLIENT-EXPOSED.
GOOGLE_MAPS_API_KEY=
# Separate server-side Google key for Places proxies. Falls back to the key above.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional per-IP cap on the Places endpoint (requests/minute). Unset = unlimited.
# GEV_RATELIMIT_GOOGLE_PER_MIN=60

# Cesium ion (ion-hosted Google 3D, Bing imagery, world terrain). CLIENT-EXPOSED.
# Check the Cesium plan terms before commercial use.
CESIUM_ION_TOKEN=

# Live AIS vessels (server-side websocket). Without it the ships layer is empty.
AISSTREAM_API_KEY=
# AISSTREAM_BOUNDING_BOXES=[[[-90,-180],[90,180]]]
# AISSTREAM_MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData,StaticDataReport
# AISSTREAM_SILENCE_TIMEOUT_MS=120000
VITE_AIS_LIVE_API_URL=/api/ais-live
VITE_AIS_LIVE_MAX_ROWS=12000
VITE_AIS_LIVE_LABEL_MAX_ROWS=900

# NASA FIRMS active fires (server-side). Without it the fires layer is empty.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# FIRMS_MAP_KEY=

# OpenSky (oauth | basic | auto | anon). anon works without credentials.
OPENSKY_AUTH_MODE=anon
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# OPENSKY_CREDENTIALS_FILE=/path/to/credentials.json

# Dev server. Default binds to localhost only; HOST=0.0.0.0 exposes the
# key-brokering proxies to the network.
PORT=4173
# HOST=localhost
